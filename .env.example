# ==============================================================================
# Aman Kumar — Portfolio Backend Environment Configuration
# ==============================================================================

# Server Runtime Configuration
PORT=3001
NODE_ENV=production

# Admin Security & Authentication
# Used for protected endpoints such as GET /api/contact/messages and POST /api/admin/backup
ADMIN_USERNAME=aman
ADMIN_PASSWORD=change_this_to_a_secure_admin_password
ADMIN_SECRET=generate_a_random_32_byte_hex_secret_here
ADMIN_API_KEY=optional_static_api_key_for_cli_access

# CORS Restrictions (comma-separated allowed origins)
ALLOWED_ORIGINS=https://aman-portfolio.example.com,http://localhost:5173,http://localhost:3000,http://localhost:3001

# GitHub API Integration (Optional)
# Increases public rate limit from 60 req/hr to 5,000 req/hr
GITHUB_TOKEN=ghp_your_github_personal_access_token_here

# Email Notification Service (Optional)
# If configured, new contact form inquiries will be dispatched immediately to your email.
# If left blank, inquiries will be securely persisted to SQLite database only.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM="Aman Portfolio" <your_email@gmail.com>
NOTIFICATION_EMAIL=1823ary@gmail.com
